USAGE = """plexctl — stack Plex + qBittorrent + Cloudflare

  plexctl services {start|stop|restart|status|watch [segs]}   (root)
  plexctl qb {list|paths|pause [busca]|resume [busca]|setlocation <dest> [hash]}
  plexctl postprocess "<nome>" "<caminho>"
  plexctl update                                              (root)
  plexctl plex-exec
  plexctl _init {start|stop|restart|status}
"""


def main(argv):
    if not argv:
        print(USAGE)
        return 1
    cmd, rest = argv[0], argv[1:]
    dispatch = {
        "services": cmd_services,
        "qb": cmd_qb,
        "postprocess": cmd_postprocess,
        "update": cmd_update,
        "plex-exec": cmd_plex_exec,
        "_init": cmd_init,
    }
    fn = dispatch.get(cmd)
    if not fn:
        print(USAGE)
        return 1
    return fn(rest)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
