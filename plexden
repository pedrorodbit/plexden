# --------------------------------------------------------------- constantes ---
# Configuravel por /etc/plexden.conf (KEY=VALUE) ou variaveis de ambiente, com
# defaults sensatos. O provision.sh grava o .conf na instalacao.
def _load_conf(path="/etc/plexden.conf"):
    conf = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


_CONF = _load_conf()


def _cfg(key, default):
    return os.environ.get(key) or _CONF.get(key) or default


PLEX_USER = _cfg("PLEXDEN_USER", "plex")
PERSIST = _cfg("PLEXDEN_HOME", "/srv/plexden")
MOVIES = os.path.join(PERSIST, "movies")
