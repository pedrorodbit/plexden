def ensure_init_stub():
    """(Re)cria os stubs de integracao que apontam para o plexden."""
    self = os.path.abspath(sys.argv[0])
    # Numa Fedora/RHEL enxuta /etc/init.d nem existe (vem com initscripts).
    os.makedirs(os.path.dirname(INIT_PLEX), exist_ok=True)
    with open(INIT_PLEX, "w") as f:
        f.write("#!/bin/sh\n"
                "### BEGIN INIT INFO\n"
                "# Provides:          plexmediaserver\n"
                "# Required-Start:    $network $remote_fs\n"
                "# Required-Stop:     $network $remote_fs\n"
                "# Default-Start:     2 3 4 5\n"
                "# Default-Stop:      0 1 6\n"
                "# Short-Description: Plex Media Server\n"
                "### END INIT INFO\n"
                f'exec {self} _init "$@"\n')
    os.chmod(INIT_PLEX, 0o755)


# ------------------------------------------- gerenciador de pacotes (update) --
# Espelha a abstracao do provision.sh, mas em Python e so para o 'update'.
def _detect_pkg():
    for m in ("apt-get", "dnf", "yum"):
        if shutil.which(m):
            return m
    return None


def _pkg_family(mgr):
    if mgr == "apt-get":
        return "deb"
    if mgr in ("dnf", "yum"):
        return "rpm"
    return None


def _plex_build():
    """Tag de build do Plex conforme a arquitetura (para a URL de download)."""
    m = os.uname().machine
    if m in ("x86_64", "amd64"):
        return "linux-x86_64"
    if m in ("aarch64", "arm64"):
        return "linux-aarch64"
    if m.startswith("armv7") or m in ("armhf", "armv6l"):
        return "linux-armv7neon"
    return None


def _plex_version_installed(fam):
    if fam == "deb":
        return sh(["dpkg-query", "-W", "-f=${Version}",
                   "plexmediaserver"]).stdout.strip()
    if fam == "rpm":
        return sh(["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}",
                   "plexmediaserver"]).stdout.strip()
    return ""


def _plex_version_file(fam, path):
    if fam == "deb":
        return sh(["dpkg-deb", "-f", path, "Version"]).stdout.strip()
    if fam == "rpm":
        return sh(["rpm", "-qp", "--qf", "%{VERSION}-%{RELEASE}",
                   path]).stdout.strip()
    return ""


def _plex_install_file(mgr, fam, path):
    """True se o pacote entrou. O codigo de saida importa: sem ele o update
    seguia adiante e anunciava 'Pronto' com o Plex parado e nao atualizado."""
    if fam == "deb":
        r = sh(f"DEBIAN_FRONTEND=noninteractive dpkg -i {path}")
        if r.returncode != 0:
            # dpkg falha por dependencia faltando; o apt-get -f resolve.
            r = sh(["apt-get", "-f", "install", "-y"])
        return r.returncode == 0
    if fam == "rpm":
        if mgr == "dnf":
            r = sh(["dnf", "install", "-y", path])
        elif mgr == "yum":
            r = sh(["yum", "install", "-y", path])
        else:
            r = sh(["rpm", "-Uvh", path])
        return r.returncode == 0
    return False


def cmd_update(args):
    require_root("update")
    # O token NAO e obrigatorio: o endpoint publico entrega o pacote do canal
    # estavel sem ele — e o provision.sh sempre baixou assim. Exigi-lo aqui
    # bloqueava o update num servidor ainda nao reivindicado, sem motivo. Ele
    # segue sendo usado quando existe, que e o que da acesso a canais de Plex
    # Pass em vez do publico.
    token = plex_token()
    if not token:
        print("(sem PlexOnlineToken — usando o canal publico)")

    mgr = _detect_pkg()
    fam = _pkg_family(mgr) if mgr else None
    if fam is None:
        print("ERRO: gerenciador de pacotes nao reconhecido para update automatico")
        return 1

    curver = _plex_version_installed(fam)
    print(f"== Versao instalada: {curver}  (via {mgr})")

    print("== Backup do banco ==")
    backup = os.path.join(PERSIST, "config-backup-" + time.strftime("%Y%m%d-%H%M%S"))
    try:
        # Pula caches regeneraveis (podem somar dezenas de GB): o que importa
        # num rollback e o banco + Preferences, nao Cache/Codecs/relatorios.
        shutil.copytree(os.path.join(PERSIST, "config"), backup, symlinks=True,
                        ignore=shutil.ignore_patterns(
                            "Cache", "Codecs", "Crash Reports"))
    except Exception as e:
        print(f"ERRO: backup falhou: {e}")
        return 1
    print(f"   {backup} ({sh(['du','-sh',backup]).stdout.split()[0]})")

    build = _plex_build()
    if not build:
        print(f"ERRO: arquitetura sem build do Plex: {os.uname().machine}")
        return 1
    distro = "debian" if fam == "deb" else "redhat"
    ext = fam
    pkgfile = f"/tmp/plex-new.{ext}"
    print(f"== Baixando .{ext} ({build}) ==")
    url = (f"https://plex.tv/downloads/latest/5?channel=16&build={build}"
           f"&distro={distro}")
    if token:
        url += f"&X-Plex-Token={token}"
    if sh(["curl", "-sL", "--max-time", "600", "-o", pkgfile, url]).returncode != 0:
        print("ERRO: download falhou")
        return 1
    newver = _plex_version_file(fam, pkgfile)
    if not newver:
        print("ERRO: pacote invalido")
        _rm(pkgfile)
        return 1
    print(f"   baixado: {newver} ({sh(['du','-h',pkgfile]).stdout.split()[0]})")

    if newver == curver:
        print("== Ja esta na versao mais recente. Nada a fazer.")
        _rm(pkgfile)
        shutil.rmtree(backup, ignore_errors=True)
        return 0

    print("== Parando Plex ==")
    plex_process_stop()
    print(f"== Instalando {newver} ==")
    ok = _plex_install_file(mgr, fam, pkgfile)
    print("== Restaurando stub do init (o pacote o remove) ==")
    ensure_init_stub()
    print("== Iniciando ==")
    plex_process_start()

    print("== Verificacao ==")
    instalada = _plex_version_installed(fam)
    print("   versao:", instalada)
    if not ok or instalada != newver:
        # O Plex acabou de ser parado; falhar em silencio aqui deixa o usuario
        # com o servidor fora do ar e uma mensagem de sucesso na tela.
        print(f"\nERRO: a instalacao de {newver} nao completou "
              f"(instalada: {instalada or 'nenhuma'}).")
        print(f"      O banco anterior esta intacto em {backup}")
        _rm(pkgfile)
        return 1
    ident = http_get(f"{PLEX_URL}/identity", timeout=10)
    cm = re.search(r'claimed="[01]"', ident)
    if cm:
        print("  ", cm.group(0))
    _rm(pkgfile)
    print(f"\nPronto. Backup do banco anterior: {backup}")
    return 0


