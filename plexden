def cmd_plex_exec(args):
    support = os.path.join(PERSIST, "config")
    os.environ["PLEX_MEDIA_SERVER_HOME"] = PLEX_BIN_DIR
    os.environ["PLEX_MEDIA_SERVER_MAX_PLUGIN_PROCS"] = "6"
    os.environ["PLEX_MEDIA_SERVER_TMPDIR"] = "/tmp"
    os.environ["PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR"] = support
