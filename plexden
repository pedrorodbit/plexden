# -------------------------------------------------------------- utilidades ---
def now():
    return time.strftime("%F %T")


def is_root():
    return os.geteuid() == 0


def require_root(argv_hint=""):
    if not is_root():
        print(f"rode como root (sudo plexden {argv_hint})".rstrip())
        sys.exit(1)


def current_user():
    import pwd
    return pwd.getpwuid(os.geteuid()).pw_name


def sh(cmd, **kw):
    """Executa comando (lista ou string) e devolve CompletedProcess.

    Binario ausente vira returncode 127 (a convencao do shell para 'command not
    found') em vez de FileNotFoundError. Sem isso, uma stack meio instalada
    derruba o plexden com traceback no lugar de uma mensagem util.
    """
    shell = isinstance(cmd, str)
    try:
        return subprocess.run(cmd, shell=shell, text=True,
                              capture_output=True, **kw)
    except (FileNotFoundError, PermissionError) as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def http_code(url, timeout=5):
    try:
        req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except Exception:
        return 0


def http_get(url, timeout=10):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.read().decode("utf-8", "replace")
    except Exception:
        return ""


def pgrep_x(name):
    return sh(["pgrep", "-x", name]).returncode == 0


def plex_token():
    try:
        with open(PREFS, encoding="utf-8", errors="replace") as f:
            data = f.read()
    except OSError:
        return ""
    m = re.search(r'PlexOnlineToken="([^"]*)"', data)
    return m.group(1) if m else ""


# ============================================================ SERVICES ========
def plex_ok():
    return http_code(f"{PLEX_URL}/identity") == 200


def qbit_ok():
    return http_code(f"{QB_URL}/") == 200


def cf_ok():
    return pgrep_x("cloudflared")


# O `cloudflared service install` cria uma unit do systemd (onde systemd e' o
# init) ou um script SysV (onde nao e'). Detectamos e usamos o caminho certo.
def _has_systemd():
    return os.path.isdir("/run/systemd/system")


def _cf_systemd_unit():
    if not (_has_systemd() and shutil.which("systemctl")):
        return False
    return "cloudflared.service" in sh(
        ["systemctl", "list-unit-files", "cloudflared.service"]).stdout


def cf_start():
    """Sobe o cloudflared pelo servico configurado. False se nao houver."""
    if _cf_systemd_unit():
        sh(["systemctl", "start", "cloudflared"])
        return True
    if os.access(INIT_CF, os.X_OK):
        sh([INIT_CF, "start"])
        return True
    return False


def cf_stop():
    if _cf_systemd_unit():
        sh(["systemctl", "stop", "cloudflared"])
    elif os.access(INIT_CF, os.X_OK):
        sh([INIT_CF, "stop"])
    sh(["pkill", "-x", "cloudflared"])


def _plex_running_pid():
    """PID do Plex via pidfile (se vivo) ou pgrep pelo padrao."""
    for pf in (PLEX_PIDFILE, "/tmp/plexmediaserver.pid"):
        try:
            with open(pf) as f:
                pid = f.read().strip()
            if pid and sh(["kill", "-0", pid]).returncode == 0:
                return pid
        except OSError:
            pass
    for pat in (f"^{PLEX_BIN_DIR}/{PLEX_PATTERN}", PLEX_PATTERN):
        r = sh(["pgrep", "-f", pat])
        if r.returncode == 0:
            return r.stdout.split()[0]
    return None


def _pidfile_writable():
    try:
        with open(PLEX_PIDFILE, "a"):
            return PLEX_PIDFILE
    except OSError:
        return "/tmp/plexmediaserver.pid"


def plex_process_start():
    pid = _plex_running_pid()
    if pid:
        print(f"  Plex         ja rodando (pid {pid})")
        return True
    pidfile = _pidfile_writable()
    starter = f"{sys.argv[0]} plex-exec"
    if current_user() == PLEX_USER:
        sh(f'nohup {starter} >{PLEX_LOGFILE} 2>&1 & echo $! >{pidfile}')
    else:
        r = sh(["su", "-", PLEX_USER, "-c",
                f'nohup {starter} >{PLEX_LOGFILE} 2>&1 & echo $!'])
        try:
            with open(pidfile, "w") as f:
                f.write(r.stdout.strip() + "\n")
        except OSError:
            pass
    for i in range(1, 61):
        if plex_ok():
            print(f"  Plex         iniciado ({i}s)")
            return True
        time.sleep(1)
    print(f"  Plex         FALHOU (veja {PLEX_LOGFILE})")
    return False


def plex_process_stop():
    if not _plex_running_pid():
        print("  Plex         ja parado")
        _rm(PLEX_PIDFILE)
        return
    for pat in (PLEX_PATTERN, "Plex Plug-in", "Plex Tuner"):
        sh(["pkill", "-f", pat])
    for _ in range(25):
        if not _plex_running_pid():
            break
        time.sleep(1)
    if _plex_running_pid():
        sh(["pkill", "-9", "-f", "Plex"])
        time.sleep(2)
    _rm(PLEX_PIDFILE)
    print("  Plex         parado")


def _rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


def _qb_legal_flag():
    """' --confirm-legal-notice', se o binario aceitar a flag.

    Ela so existe a partir do qB 5. Na serie 4.x o binario responde
    'unknown command line parameter' e nem sobe — passar a flag as cegas
    quebra a stack inteira nessas distros. O aceite do aviso, la, vem do
    [LegalNotice] gravado no qBittorrent.conf pelo provision.
    """
    out = sh(["qbittorrent-nox", "--help"]).stdout or ""
    return " --confirm-legal-notice" if "--confirm-legal-notice" in out else ""


def start_qbit():
    if qbit_ok():
        print("  qBittorrent  ja no ar")
        return True
    sh(["pkill", "-x", "qbittorrent-nox"])
    time.sleep(3)
    sh(["su", "-", PLEX_USER, "-c", "qbittorrent-nox --daemon" + _qb_legal_flag()])
    for i in range(1, 16):
        if qbit_ok():
            print(f"  qBittorrent  iniciado ({i}s)")
            return True
        time.sleep(1)
    print("  qBittorrent  FALHOU")
    return False


def start_plex():
    if plex_ok():
        print("  Plex         ja no ar")
        return True
    # Processo vivo mas sem responder HTTP = travado. Antes daqui, o
    # plex_process_start() via o pid, dizia "ja rodando" e devolvia sucesso —
    # o watchdog entao repetia "Plex caiu" para sempre sem nunca reerguer nada.
    if _plex_running_pid():
        print("  Plex         travado (processo vivo, HTTP mudo) — derrubando")
        plex_process_stop()
    return plex_process_start()


def cf_configured():
    """O tunnel e opcional. So consideramos que ele existe se ha servico
    instalado ou credenciais no lugar — sem isso, cloudflared fora do ar e o
    estado esperado, nao uma falha da stack."""
    return bool(_cf_systemd_unit()) or os.access(INIT_CF, os.X_OK) or \
        os.path.isfile("/etc/cloudflared/cert.pem") or \
        os.path.isfile(os.path.join(PERSIST, "cloudflared", "cert.pem"))


def start_cf():
    if cf_ok():
        print("  cloudflared  ja no ar")
        return True
    if not cf_configured():
        print("  cloudflared  nao configurado (tunnel e opcional) — ignorando")
        return True
    if not cf_start():
        print("  cloudflared  SEM servico (systemd/init) — rode provision")
        return False
    for i in range(1, 16):
        if cf_ok():
            print(f"  cloudflared  iniciado ({i}s)")
            return True
        time.sleep(1)
    print("  cloudflared  FALHOU")
    return False


def do_start():
    print("== Subindo servicos ==")
    ok = True
    ok &= start_qbit()
    ok &= start_plex()
    ok &= start_cf()
    return 0 if ok else 1


def do_stop():
    print("== Parando servicos ==")
    plex_process_stop()
    # qBittorrent grava a sessao no SIGTERM; da ate 30s antes de forcar -9.
    if pgrep_x("qbittorrent-nox"):
        sh(["pkill", "-x", "qbittorrent-nox"])
        for _ in range(30):
            if not pgrep_x("qbittorrent-nox"):
                break
            time.sleep(1)
        if pgrep_x("qbittorrent-nox"):
            print("  qBittorrent  nao encerrou em 30s — forcando (sessao pode ser perdida)")
            sh(["pkill", "-9", "-x", "qbittorrent-nox"])
            time.sleep(1)
    print("  qBittorrent  parado")
    cf_stop()
    print("  cloudflared  parado")
    return 0


def do_status():
    print("== Status ==")
    if plex_ok():
        ident = http_get(f"{PLEX_URL}/identity", timeout=5)
        vers = re.findall(r'version="([^"]*)"', ident)
        v = vers[-1] if vers else "?"
        cm = re.search(r'claimed="([01])"', ident)
        print(f"  Plex         OK      v{v}  claimed={cm.group(1) if cm else '?'}")
    else:
        print("  Plex         PARADO")
    print("  qBittorrent  OK" if qbit_ok() else "  qBittorrent  PARADO")
    if cf_ok():
        print("  cloudflared  OK")
    elif cf_configured():
        print("  cloudflared  PARADO")
    else:
        print("  cloudflared  nao configurado (opcional)")
    print("\n  Volume persistente:")
    try:
        st = os.statvfs(PERSIST)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used_pct = int(round((total - free) * 100 / total)) if total else 0
        gb = lambda b: f"{b / (1024**3):.0f}G"
        print(f"    {PERSIST}: {gb(free)} livres de {gb(total)} ({used_pct}% usado)")
    except OSError:
        # Caminho inexistente/inacessivel: dizer isso, em vez de deixar o
        # cabecalho vazio (e o que acontece antes da stack ser instalada).
        print(f"    {PERSIST}: nao encontrado — rode o provision.sh")
    return 0


def do_watch(interval):
    os.makedirs(LOGDIR, exist_ok=True)
    print(f"Vigiando a cada {interval}s. Log: {WATCHLOG}")
    log = lambda m: open(WATCHLOG, "a").write(f"{now()} {m}\n")
    log(f"watchdog iniciado (intervalo {interval}s)")
    while True:
        if not plex_ok():
            log("Plex caiu — reerguendo")
            start_plex()
        if not qbit_ok():
            log("qBittorrent caiu — reerguendo")
            start_qbit()
        # Sem o cf_configured() isto registrava "cloudflared caiu" a cada
        # intervalo, para sempre, em toda instalacao sem tunnel — enchendo o log
        # com uma afirmacao falsa sobre um servico que nunca esteve no ar.
        if cf_configured() and not cf_ok():
            log("cloudflared caiu — reerguendo")
            start_cf()
        time.sleep(interval)


def cmd_services(args):
    action = args[0] if args else "status"
    if action == "status":   # so leitura (HTTP + statvfs): dispensa root
        return do_status()
    require_root("services " + action)
    if action == "start":
        return do_start()
    if action == "stop":
        return do_stop()
    if action == "restart":
        do_stop()
        time.sleep(3)
        return do_start()
    if action == "watch":
        do_watch(int(args[1]) if len(args) > 1 else 60)
        return 0
    print("Uso: plexden services {start|stop|restart|watch [segundos]} (root)\n"
          "     plexden services status                          (dispensa root)")
    return 1


# ============================================================ INIT (stub) =====
def cmd_init(args):
    action = args[0] if args else ""
    if action == "start":
        return 0 if plex_process_start() else 1
    if action == "stop":
        plex_process_stop()
        return 0
    if action == "restart":
        plex_process_stop()
        time.sleep(2)
        return 0 if plex_process_start() else 1
    if action == "status":
        pid = _plex_running_pid()
        if pid:
            code = http_code(f"{PLEX_URL}/identity")
            print(f"Plex Media Server rodando (pid {pid}) — HTTP {code}")
            return 0
        print("Plex Media Server parado")
        return 3
    print("Uso: plexden _init {start|stop|restart|status}")
    return 1


