    os.chdir(PLEX_BIN_DIR)
    os.execv(f"./{PLEX_PATTERN}", [PLEX_PATTERN])


# ============================================================ QBITTORRENT =====
class QB:
    def __init__(self):
        self.creds = self._load_creds()
        self.jar = http.cookiejar.CookieJar()
        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.jar))

    @staticmethod
    def _load_creds():
        path = os.environ.get("QB_CREDS", os.path.expanduser("~/.qbcreds"))
        if not os.path.isfile(path):
            sys.exit(f"ERRO: {path} nao existe.\n"
                     "Crie com: printf 'QB_USER=admin\\nQB_PASS=SENHA\\n' "
                     "> ~/.qbcreds && chmod 600 ~/.qbcreds")
        c = {}
        with open(path) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    c[k.strip()] = v.strip()
        if not c.get("QB_USER") or not c.get("QB_PASS"):
            sys.exit(f"ERRO: QB_USER/QB_PASS ausentes em {path}")
        return c

    def _req(self, path, data=None):
        url = f"{QB_URL}{path}"
        body = urllib.parse.urlencode(data).encode() if data is not None else None
        req = urllib.request.Request(url, data=body,
                                     headers={"Referer": QB_URL})
        with self.opener.open(req, timeout=30) as r:
            return r.status, r.read().decode("utf-8", "replace")

    def _tem_sessao(self):
        """True se o qB entregou o cookie de sessao (SID_*/QBT_SID_*)."""
        return any(c.name.startswith(("SID", "QBT_SID")) for c in self.jar)

    def login(self):
        try:
            status, text = self._req("/api/v2/auth/login",
                                     {"username": self.creds["QB_USER"],
                                      "password": self.creds["QB_PASS"]})
        except Exception as e:
            sys.exit(f"ERRO no login: {e}")
        # Ate o qB 5.1 a resposta era 200 com o corpo "Ok."; o 5.2 passou a
        # responder 204 sem corpo nenhum, entregando so o cookie. Quem decide,
        # entao, e o cookie de sessao — nao o texto.
        if text.strip() == "Ok." or (200 <= status < 300 and self._tem_sessao()):
            return
        sys.exit(f"ERRO no login: HTTP {status} {text.strip() or '(sem corpo)'}\n"
                 "(confira QB_USER/QB_PASS em ~/.qbcreds)")

    def torrents(self, hashes=None):
        path = "/api/v2/torrents/info"
        if hashes:
            path += "?" + urllib.parse.urlencode({"hashes": hashes})
        _, text = self._req(path)
        return json.loads(text)

    def action(self, name, data):
        code, _ = self._req(f"/api/v2/torrents/{name}", data)
        return code

    def webapi_version(self):
        """(maior, menor, ...) da Web API. Em 2.11+ (qB 5.0) pause/resume
        viraram stop/start."""
        try:
            _, t = self._req("/api/v2/app/webapiVersion")
            return tuple(int(x) for x in t.strip().split("."))
        except Exception:
            return (0,)


def _fmt_size(b):
    b = float(b)
    for u in ("B", "KB", "MB", "GB", "TB"):
        if b < 1024 or u == "TB":
            return f"{b:.1f}{u}"
        b /= 1024


def _matching(torrents, term):
    term = (term or "").lower()
    return [t for t in torrents if not term or term in t["name"].lower()]


def cmd_qb(args):
    action = args[0] if args else "list"
    qb = QB()
    qb.login()

    if action == "list":
        ts = qb.torrents()
        print(f"{'ESTADO':<12} {'%':>6} {'BAIXADO':>10} {'TOTAL':>10}  NOME")
        print("-" * 100)
        for t in ts:
            print(f"{t['state']:<12} {t['progress']*100:5.1f}% "
                  f"{_fmt_size(t['downloaded']):>10} {_fmt_size(t['size']):>10}  "
                  f"{t['name'][:55]}")
        print(f"\ntotal: {len(ts)} torrent(s)")
        return 0

    if action == "paths":
        ts = qb.torrents()
        counts = {}
        for t in ts:
            counts[t["save_path"]] = counts.get(t["save_path"], 0) + 1
        print("destinos em uso:")
        for p in sorted(counts, key=lambda k: -counts[k]):
            print(f"  {counts[p]:3d}x  {p}")
        print()
        for t in ts:
            print(f"  {t['hash'][:8]}  {t['save_path']}  {t['name'][:45]}")
        return 0

    if action in ("pause", "resume"):
        term = args[1] if len(args) > 1 else ""
        rows = _matching(qb.torrents(), term)
        if not rows:
            print(f'nenhum torrent casa com "{term}"' if term else "nenhum torrent")
            return 0
        # O termo e' substring: uma busca larga pega mais torrent do que se
        # espera. Mostrar estado e progresso de cada um faz o estrago aparecer
        # antes de acontecer — um "stalledUP 100%" nesta lista quer dizer que a
        # busca alcancou algo que ja estava completo e semeando.
        print(f"{action} em {len(rows)} torrent(s):")
        for t in rows:
            print(f"  {t['state']:<12} {t['progress']*100:5.1f}%  {t['name'][:58]}")
        # qB 5.0 (Web API 2.11) renomeou pause->stop e resume->start.
        endpoint = action
        if qb.webapi_version() >= (2, 11):
            endpoint = "stop" if action == "pause" else "start"
        code = qb.action(endpoint, {"hashes": "|".join(t["hash"] for t in rows)})
        # O total repetido no fim, e nao so no cabecalho: quem le saida longa
        # corta o comeco, nao o fim.
        print(f"  -> HTTP {code}  ({len(rows)} torrent(s) afetados)")
        if not 200 <= code < 300:
            # Sem isto um 404 (endpoint errado para a versao do qB) passava por
            # sucesso, e o torrent seguia rodando sem ninguem notar.
            print(f"  ERRO: {endpoint} nao foi aceito pela Web API")
            return 1
        return 0

    if action == "setlocation":
        if len(args) < 2:
            print("uso: plexden qb setlocation <destino> [hash]")
            return 1
        dest = args[1]
        h = args[2] if len(args) > 2 else "|".join(
            t["hash"] for t in qb.torrents())
        if not h:
            print("nenhum torrent para mover")
            return 0
        code = qb.action("setLocation", {"hashes": h, "location": dest})
        msg = {200: "ok — o qBittorrent move em background",
               403: "ERRO 403: destino sem permissao de escrita",
               409: "ERRO 409: destino invalido ou inacessivel"}.get(
                   code, f"HTTP {code}")
        print(msg)
        # Imprimia "ERRO 403" e saia com 0: quem chamasse por script nao tinha
        # como saber que o move nao aconteceu.
        return 0 if 200 <= code < 300 else 1

    print("Uso: plexden qb {list|paths|setlocation <destino> [hash]|"
          "pause [busca]|resume [busca]}")
    return 1


# ============================================================ POSTPROCESS =====
_SERIES_RE = re.compile(
    r"(s\d{1,2}[ ._;-]?e\d{1,3})|(\b\d{1,2}x\d{2}\b)|temporada|season|"
    r"\btemp\b|epis[oó]di|complete[ ._-]*series", re.IGNORECASE)
_SE_RE = re.compile(r"^(.*)[._\s-][Ss](\d{1,2})[._\s-]?[Ee]\d{1,3}")
_NX_RE = re.compile(r"^(.*)[._\s-](\d{1,2})[xX](\d{2})([._\s-]|$)")


def _autolog(msg):
    os.makedirs(LOGDIR, exist_ok=True)
    with open(AUTORUN_LOG, "a") as f:
        f.write(f"{now()} {msg}\n")


def _clean_show(raw):
    # '/' nunca sobrevive: 'name' vem cru do %N do qBittorrent (nome do
    # torrent, escolhido por quem o criou) e vira componente de caminho no
    # fallback do postprocess. Sem isto, um nome como "/home/plex/x season 1"
    # escapava de SERIES via os.path.join(SERIES, "/abs/...") — que descarta
    # SERIES por completo quando o segundo argumento e absoluto.
    raw = raw.replace("/", " ")
    return re.sub(r"\s+", " ", raw.replace(".", " ").replace("_", " ")).strip()


def _parse_show_season(fname):
    m = _SE_RE.match(fname) or _NX_RE.match(fname)
    if not m:
        return None
    show = _clean_show(m.group(1))
    return (show, int(m.group(2))) if show else None


def _size_mb(path):
    try:
        return os.path.getsize(path) // (1024 * 1024)
    except OSError:
        return 0


# Razao dos links que o postprocess criou: destino na biblioteca -> origem no
# torrents/. Existe para responder uma pergunta so: "este arquivo da biblioteca
# veio de qual torrent?".
#
# Sem a razao, o unico sinal disponivel seria st_nlink == 1 ("mais ninguem
# aponta para este dado"). So que isso tambem descreve toda a midia que a pessoa
# copiou para a biblioteca por fora do plexden — apagar por esse criterio
# destruiria acervo que o plexden nunca tocou. Dai o registro explicito: o
# 'plexden links' so mexe no que esta aqui dentro.
def _links_load():
    try:
        with open(LINKS_DB) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    links = data.get("links") if isinstance(data, dict) else None
    return links if isinstance(links, dict) else {}


def _links_save(links):
    os.makedirs(os.path.dirname(LINKS_DB), exist_ok=True)
    tmp = LINKS_DB + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"version": 1, "links": links}, f,
                  ensure_ascii=False, indent=1, sort_keys=True)
    # Troca atomica: uma queda no meio da escrita nunca deixa a razao truncada,
    # que e o unico jeito de o plexden "esquecer" a procedencia de um arquivo.
    os.replace(tmp, LINKS_DB)


def _links_merge(novos):
    if not novos:
        return
    links = _links_load()
    links.update(novos)
    try:
        _links_save(links)
    except OSError as e:
        # O postprocess ja criou os hardlinks a esta altura. Morrer aqui por
        # causa da razao seria trocar "midia organizada, procedencia perdida"
        # por "traceback no AutoRun do qB". O aviso vai para o log e a midia
        # fica — so nao entra na conta do 'plexden links'.
        _autolog(f"  AVISO: nao consegui gravar a razao ({LINKS_DB}): {e}")


def _hardlink(src, dst, ledger=None, root=None):
    """True se o arquivo passou a existir no destino agora.

    O contador do postprocess depende disso: antes ele somava tambem os
    arquivos pulados e os que falharam, e anunciava "N arquivos linkados"
    para N que nao tinham sido linkados.

    Quando 'ledger' e um dict, o par destino->origem e anotado nele para o
    chamador gravar na razao de uma vez so (ver _links_merge).

    Quando 'root' e dado, 'dst' fora dele e recusado. Segunda barreira contra
    o mesmo risco que _clean_show ja neutraliza na origem (nome de torrent
    virando caminho): aqui pega qualquer jeito de 'dst' escapar da biblioteca,
    inclusive um que a gente ainda nao pensou.
    """
    if root is not None and not _sob(dst, root):
        _autolog(f"  BLOQUEADO (fora de {root}): {dst}")
        return False
    if os.path.exists(dst):
        _autolog(f"  ja existe, pulando: {dst}")
        return False
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    modo = "link"
    try:
        os.link(src, dst)
        _autolog(f"  link: {dst}")
    except OSError:
        # Hardlink nao cruza sistema de arquivos. Se torrents/ e a biblioteca
        # estao em discos diferentes, copiar e o unico caminho — e ai o espaco
        # e realmente duplicado.
        try:
            shutil.copy2(src, dst)
            _autolog(f"  COPIA (hardlink impossivel, espaco duplicado): {dst}")
            modo = "copia"
        except OSError:
            _autolog(f"  ERRO ao linkar: {src}")
            return False
    if ledger is not None:
        ledger[dst] = {"src": src, "modo": modo,
                       "tamanho": _size_mb(dst), "em": now()}
    return True


def _walk_files(content):
    if os.path.isdir(content):
        for root, _, files in os.walk(content):
            for fn in files:
                yield os.path.join(root, fn)
    else:
        yield content


def _trigger_scan(scan_dir):
    token = plex_token()
    if not token:
        _autolog("  AVISO: token do Plex ausente, scan nao disparado")
        return
    xml = http_get(f"{PLEX_URL}/library/sections?X-Plex-Token={token}")
    key = None
    try:
        root = ET.fromstring(xml)
        for d in root.findall("Directory"):
            for loc in d.findall("Location"):
                if loc.get("path") == scan_dir:
                    key = d.get("key")
                    break
            if key:
                break
    except ET.ParseError:
        pass
    if key:
        http_get(f"{PLEX_URL}/library/sections/{key}/refresh"
                 f"?X-Plex-Token={token}")
        _autolog(f"  scan disparado na secao {key} ({scan_dir})")
    else:
        _autolog(f"  AVISO: secao do Plex para {scan_dir} nao encontrada")


def cmd_postprocess(args):
    if len(args) < 2:
        print('uso: plexden postprocess "<nome>" "<caminho>"')
        return 1
    name, content = args[0], args[1]
    if not os.path.exists(content):
        _autolog(f"ERRO: caminho inexistente: {content}")
        print("caminho inexistente")
        return 1

    _autolog(f"=== inicio: '{name}' <- {content}")
    os.makedirs(MOVIES, exist_ok=True)
    os.makedirs(SERIES, exist_ok=True)

    vids = [f for f in _walk_files(content)
            if f.rsplit(".", 1)[-1].lower() in VID_EXT]
    kind = "series" if (_SERIES_RE.search(name) or
                        any(_SERIES_RE.search(os.path.basename(v)) for v in vids)) \
        else "movie"
    _autolog(f"  tipo detectado: {kind}")

    linked = 0
    novos = {}          # o que entrar aqui vai para a razao no fim
    if kind == "movie":
        for vid in vids:
            if _size_mb(vid) < MIN_VIDEO_MB:
                _autolog(f"  ignora video pequeno ({_size_mb(vid)}MB): "
                         f"{os.path.basename(vid)}")
                continue
            if _hardlink(vid, os.path.join(MOVIES, os.path.basename(vid)),
                         novos, root=MOVIES):
                linked += 1
            base = vid.rsplit(".", 1)[0]
            for ext in SUB_EXT:
                sub = f"{base}.{ext}"
                if os.path.exists(sub):
                    _hardlink(sub, os.path.join(MOVIES, os.path.basename(sub)),
                              novos, root=MOVIES)
        scan_dir = MOVIES
    else:
        fallback = os.path.join(SERIES, _clean_show(name))
        for f in _walk_files(content):
            ext = f.rsplit(".", 1)[-1].lower()
            if ext in VID_EXT:
                if _size_mb(f) < MIN_VIDEO_MB:
                    continue
            elif ext not in SUB_EXT:
                continue
            fname = os.path.basename(f)
            ss = _parse_show_season(fname)
            if ss:
                show, season = ss
                dst = os.path.join(SERIES, show, f"Season {season:02d}", fname)
            else:
                _autolog(f"  sem temporada no nome, usando fallback: {fname}")
                dst = os.path.join(fallback, fname)
            if _hardlink(f, dst, novos, root=SERIES):
                linked += 1
        scan_dir = SERIES

    _links_merge(novos)
    _autolog(f"  arquivos linkados: {linked}")
    _trigger_scan(scan_dir)
    _autolog(f"=== fim: '{name}' ({kind}, {linked} arquivos)")
    print(f"ok: {name} -> {kind} ({linked} arquivos linkados)")
    return 0


# ============================================================ LINKS ===========
def _sob(path, raiz):
    """True se 'path' esta dentro de 'raiz'."""
    raiz = os.path.join(os.path.realpath(raiz), "")
    return os.path.realpath(path).startswith(raiz)


def _poda_vazios(path, raizes):
    """Sobe removendo diretorios que ficaram vazios, sem passar das raizes.

    Sem isso, apagar a ultima temporada de uma serie deixa
    'series/Nome/Season 04/' vazio na biblioteca — e o Plex mantem a serie
    listada, sem episodio nenhum dentro.
    """
    d = os.path.dirname(path)
    while any(_sob(d, r) for r in raizes):
        try:
            os.rmdir(d)                 # falha de proposito se nao estiver vazio
        except OSError:
            return
        d = os.path.dirname(d)


def _indice_por_inode(raiz):
    """(dev, ino) -> primeiro caminho encontrado, para tudo debaixo de 'raiz'."""
    idx = {}
    for d, _, arquivos in os.walk(raiz):
        for fn in arquivos:
            c = os.path.join(d, fn)
            try:
                st = os.stat(c)
            except OSError:                 # link quebrado, permissao, corrida
                continue
            idx.setdefault((st.st_dev, st.st_ino), c)
    return idx


def cmd_links_scan(aplica):
    """Reconstroi a razao pelo inode, para o acervo que veio de antes dela.

    Hardlink e fonte sao o mesmo inode — entao o par pode ser redescoberto sem
    adivinhar por nome ou tamanho. E o que traz para dentro do 'plexden links'
    a biblioteca que ja existia quando a razao foi criada.

    O que nao casa fica de fora e assim permanece: um arquivo sem fonte viva
    pode ser tanto "veio de um torrent que ja foi apagado" quanto "foi copiado
    aqui na mao", e nao ha como distinguir os dois depois do fato. Na duvida,
    nao se apaga — esses nunca entram na razao, logo nunca sao removidos.
    """
    print(f"varredura por inode em {PERSIST}")
    fontes = _indice_por_inode(TORRENTS)
    links = _links_load()
    ja, adotar, sem_fonte = 0, {}, []
    biblioteca = set()
    for raiz in (MOVIES, SERIES):
        for chave, dst in _indice_por_inode(raiz).items():
            biblioteca.add(chave)
            if dst in links:
                ja += 1
            elif chave in fontes:
                adotar[dst] = {"src": fontes[chave], "modo": "link",
                               "tamanho": _size_mb(dst), "em": now(),
                               "origem": "scan"}
            else:
                sem_fonte.append(dst)

    # A direcao inversa: baixado, mas nunca chegou na biblioteca. So video
    # grande — senao a lista vira .txt, .nfo, capa e amostra do torrent.
    nao_linkados = [c for chave, c in fontes.items()
                    if chave not in biblioteca
                    and c.rsplit(".", 1)[-1].lower() in VID_EXT
                    and _size_mb(c) >= MIN_VIDEO_MB]

    print(f"  ja na razao:                     {ja:4d}")
    print(f"  fonte viva -> pode adotar:       {len(adotar):4d}")
    print(f"  sem fonte identificavel:         {len(sem_fonte):4d}")
    print(f"  baixado sem link na biblioteca:  {len(nao_linkados):4d}")

    if sem_fonte:
        print("\nsem fonte identificavel — ficam de fora da razao, e por isso")
        print("nunca serao removidos pelo 'plexden links':")
        for dst in sorted(sem_fonte)[:15]:
            print(f"  {dst}")
        if len(sem_fonte) > 15:
            print(f"  ... e mais {len(sem_fonte) - 15}")

    if nao_linkados:
        print("\nbaixado mas fora da biblioteca (postprocess nao rodou ou"
              " ignorou):")
        for c in sorted(nao_linkados)[:15]:
            print(f"  {c}")
        if len(nao_linkados) > 15:
            print(f"  ... e mais {len(nao_linkados) - 15}")

    if not adotar:
        print("\nnada novo a adotar")
        return 0
    if not aplica:
        print(f"\n{len(adotar)} par(es) identificado(s) — "
              f"'plexden links --scan --apply' grava na razao")
        print("(a varredura nao remove nada, nem com --apply)")
        return 0
    _links_merge(adotar)
    print(f"\n{len(adotar)} par(es) gravado(s) na razao — a partir de agora o")
    print("'plexden links' acompanha esses arquivos. Nada foi removido.")
    return 0


def cmd_links(args):
    """Reconcilia a biblioteca com o torrents/: fonte apagada, link vai junto.

    O gatilho e apagar o download — por espaco, por desinteresse, ou porque o
    qBittorrent removeu o torrent com os arquivos. A biblioteca acompanha.
    """
    aplica = "--apply" in args
    if "--scan" in args:
        return cmd_links_scan(aplica)
    links = _links_load()
    print(f"razao: {LINKS_DB}")
    if not links:
        print("  (vazia — nada registrado ainda)")
        print("\nSo entra na razao o que o 'plexden postprocess' linkar daqui")
        print("pra frente. O que ja estava na biblioteca nunca e' tocado.")
        return 0

    em_dia, sumidos, orfaos, fora = 0, [], [], []
    for dst in sorted(links):
        src = links[dst].get("src") or ""
        if src and os.path.exists(src):
            em_dia += 1
        elif not os.path.exists(dst):
            # Acordado: o destino ja nao esta onde foi registrado (renomeado ou
            # apagado a mao). Nao saimos cacando o arquivo — so limpamos a razao.
            sumidos.append(dst)
        elif not (_sob(dst, MOVIES) or _sob(dst, SERIES)):
            # Razao adulterada ou PLEXDEN_HOME trocado depois do registro. Nao
            # removemos nada fora da biblioteca, em hipotese nenhuma.
            fora.append(dst)
        else:
            orfaos.append(dst)

    print(f"  em dia (fonte presente):        {em_dia:4d}")
    print(f"  fonte apagada -> link vai junto:{len(orfaos):4d}")
    print(f"  destino ja nao existe:          {len(sumidos):4d}")
    if fora:
        print(f"  fora da biblioteca (IGNORADO):  {len(fora):4d}")
        for dst in fora:
            print(f"    {dst}")

    if orfaos:
        print("\nfonte apagada:")
        for dst in orfaos:
            rec = links[dst]
            aviso = "  [COPIA: o dado so existe aqui]" \
                if rec.get("modo") == "copia" else ""
            print(f"  {dst}{aviso}")
            print(f"      fonte: {rec.get('src')}")

    if not aplica:
        if orfaos or sumidos:
            print("\nnada foi removido — 'plexden links --apply' aplica")
        return 0

    raizes = (MOVIES, SERIES)
    removidos, falhas, tocou = 0, 0, set()
    for dst in orfaos:
        try:
            os.remove(dst)
        except OSError as e:
            print(f"  ERRO ao remover {dst}: {e}")
            falhas += 1
            continue
        _poda_vazios(dst, raizes)
        tocou.add(MOVIES if _sob(dst, MOVIES) else SERIES)
        del links[dst]
        removidos += 1
    for dst in sumidos:
        del links[dst]
    try:
        _links_save(links)
    except OSError as e:
        # Aqui a razao ficou atrasada em relacao ao disco: os arquivos ja
        # sairam. Reclamar alto e melhor do que a proxima execucao reencontrar
        # entradas cujo destino "sumiu" e nao saber por que.
        print(f"\nERRO: os links foram removidos mas a razao nao pode ser "
              f"gravada ({LINKS_DB}): {e}")
        return 1

    print(f"\nremovidos {removidos} link(s), "
          f"{len(sumidos)} entrada(s) obsoleta(s) limpa(s) da razao")
    # Sem o rescan o Plex segue exibindo o item, e clicar nele da erro.
    for raiz in sorted(tocou):
        _trigger_scan(raiz)
        print(f"  rescan pedido: {raiz}")
    return 1 if falhas else 0


