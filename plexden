USAGE = """plexden — stack Plex + qBittorrent + Cloudflare

  plexden services {start|stop|restart|watch [segs]}          (root)
  plexden services status                                     (dispensa root)
  plexden qb {list|paths|pause [busca]|resume [busca]|setlocation <dest> [hash]}
