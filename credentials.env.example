# Copie para credentials.env (fora do Git) e preencha.
# O provision.sh usa QB_USER/QB_PASS daqui para regenerar o ~/.qbcreds.
#
#   cp credentials.env.example credentials.env
#   chmod 600 credentials.env

# qBittorrent WebUI
QB_USER=admin
QB_PASS=troque-esta-senha

# Cloudflare Tunnel: o UUID NAO vem deste arquivo. Ele e' auto-detectado pelo
# *.json em $PLEXDEN_HOME/cloudflared/. Para forcar, passe por variavel de
# ambiente ao rodar o provision:
#   sudo CF_TUNNEL_UUID=xxxxxxxx-xxxx-xxxx ./provision.sh
