# Copie para credentials.env (fora do Git) e preencha.
# O provision.sh usa QB_USER/QB_PASS para regenerar ~/.qbcreds.
#
#   cp credentials.env.example credentials.env
#   chmod 600 credentials.env

# qBittorrent WebUI
QB_USER=admin
QB_PASS=troque-esta-senha

# Cloudflare Tunnel (opcional) — UUID do tunnel; se vazio, o provision
# auto-detecta pelo *.json em cloudflared/.
CF_TUNNEL_UUID=
